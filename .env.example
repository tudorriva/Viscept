# Backend Configuration
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT=300000
GROQ_MIN_RESPONSE_MS=1800
GROQ_DEBUG=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=300000
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral
VISION_MODEL=granite3.2-vision:2b
OLLAMA_TIMEOUT=300000
VLM_TIMEOUT=120000

# Server
PORT=3001
NODE_ENV=development

# Frontend API URL (for Docker, use http://backend:3001)
FRONTEND_API_URL=http://localhost:3001

# Optional: PlantUML Server
ENABLE_PLANTUML=true
PLANTUML_SERVER=https://www.plantuml.com/plantuml/svg/

# Optional: Enable strict mode (only code output, no explanation)
STRICT_MODE=false
