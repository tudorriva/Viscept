# ─── Viscept Backend Configuration ───────────────────────────────────────────

# ─── Ollama Configuration ────────────────────────────────────────────────────
# Base URL for the local Ollama instance
OLLAMA_URL=http://localhost:11434

# Generative model for diagram code generation (Viscept recommended)
# Options: viscept (best for diagrams), qwen2.5-coder:7b (good alternative), mistral, llama3.1:8b
OLLAMA_MODEL=viscept

# Vision-Language Model for visual validation (VLM Judge)
# Options: granite3.2-vision:2b (recommended — capable, small, and efficient)
#          qwen2.5vl:3b (very good, but larger)
#          moondream:latest (lightest, weakest quality)
OLLAMA_VLM_MODEL=granite3.2-vision:2b

# Set to true when VLM can't co-reside with coder in VRAM (triggers GPU swap)
VLM_EVICT_CODER=false

# Timeout for Ollama API calls (ms) — 5 minutes default
OLLAMA_TIMEOUT=300000

# Timeout for VLM validation calls (ms) — 5 minutes for qwen2.5vl:3b
VLM_TIMEOUT=300000

# ─── Self-Correction Pipeline ────────────────────────────────────────────────
# Maximum visual validation retries before accepting the result
MAX_VALIDATION_RETRIES=2

# Cooldown between model switches (ms) — helps with VRAM on limited hardware
MODEL_COOLDOWN_MS=2000

# ─── Generation Settings ─────────────────────────────────────────────────────
# Max output length (chars) to prevent huge responses
MAX_OUTPUT_LENGTH=10000

# Strict mode: if true, backend ensures only code output (no explanations)
STRICT_MODE=false

# PlantUML fallback server
PLANTUML_SERVER=https://www.plantuml.com/plantuml/svg/

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
